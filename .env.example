# Tiger Cloud (the default compose setup): paste your service's connection string here,
# keeping ?sslmode=require on the end, and comment out the local line below.
# DATABASE_URL=postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require

# Local TimescaleDB (compose.local.yaml). Works as-is, nothing to fill in.
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# Only needed on the `api` branch. Free key (8 req/min, 800/day): https://twelvedata.com/pricing
TWELVEDATA_API_KEY=
