{
  "title": "Crypto Prices",
  "schemaVersion": 41,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "2026-01-12T00:00:00.000Z",
    "to": "2026-01-30T00:00:00.000Z"
  },
  "templating": {
    "list": [
      {
        "name": "symbol",
        "label": "Symbol",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_TIGER}"
        },
        "query": "SELECT DISTINCT symbol FROM one_day_candle ORDER BY 1",
        "definition": "SELECT DISTINCT symbol FROM one_day_candle ORDER BY 1",
        "refresh": 1,
        "current": {
          "text": "BTC/USD",
          "value": "BTC/USD"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "$symbol last price",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT last(price, time) AS price\nFROM crypto_ticks\nWHERE symbol = '$symbol' AND $__timeFilter(time)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 1,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      }
    },
    {
      "type": "stat",
      "title": "$symbol change",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100 * (last(close, bucket) / first(\"open\", bucket) - 1) AS pct_change\nFROM one_hour_candle\nWHERE symbol = '$symbol' AND $__timeFilter(bucket)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      }
    },
    {
      "type": "stat",
      "title": "Ticks in range",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(ticks) AS ticks\nFROM one_hour_candle\nWHERE symbol = '$symbol' AND $__timeFilter(bucket)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 3,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      }
    },
    {
      "type": "stat",
      "title": "Rows in crypto_ticks",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT approximate_row_count('crypto_ticks') AS rows"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 4,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      }
    },
    {
      "type": "candlestick",
      "title": "$symbol hourly candles",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT bucket AS time, \"open\", high, low, \"close\", ticks AS volume\nFROM one_hour_candle\nWHERE symbol = '$symbol' AND $__timeFilter(bucket)\nORDER BY bucket"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "volume"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "displayName",
                "value": "ticks"
              }
            ]
          }
        ]
      },
      "options": {
        "mode": "candles+volume",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "includeAllFields": false,
        "colors": {
          "up": "green",
          "down": "red"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 5,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      }
    },
    {
      "type": "timeseries",
      "title": "$symbol price from raw ticks",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('$__interval', time) AS time,\n       avg(price) AS avg_price\nFROM crypto_ticks\nWHERE symbol = '$symbol' AND $__timeFilter(time)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 6,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      }
    },
    {
      "type": "barchart",
      "title": "Change over range, all assets",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.name AS asset,\n       round((100 * (last(c.close, c.bucket) / first(c.\"open\", c.bucket) - 1))::numeric, 2) AS pct_change\nFROM one_hour_candle c\nJOIN crypto_assets a USING (symbol)\nWHERE $__timeFilter(c.bucket)\nGROUP BY a.name\nORDER BY pct_change DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "asset",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        },
        "colorByField": "pct_change"
      },
      "id": 7,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      }
    }
  ],
  "__inputs": [
    {
      "name": "DS_TIGER",
      "label": "Tiger Data",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ]
}